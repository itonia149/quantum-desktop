#!/usr/bin/env python3
"""Open the local Quantum file manager."""
import json
from pathlib import Path
import subprocess
import time
from urllib.request import urlopen

settings = json.loads((Path.home() / '.config/quantum-desktop/desktop.json').read_text())
subprocess.run(['systemctl', '--user', 'start', 'filebrowser-quantum.service'], check=True)
url = 'http://127.0.0.1:' + str(settings['port']) + '/'
for attempt in range(100):
    try:
        with urlopen(url, timeout=1):
            break
    except OSError:
        time.sleep(0.1)
else:
    raise SystemExit('Quantum did not become ready; check journalctl --user -u filebrowser-quantum')
subprocess.Popen([settings['browser'], url], stdout=subprocess.DEVNULL,
                 stderr=subprocess.DEVNULL, start_new_session=True)
